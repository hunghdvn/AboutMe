@inject ThemeService ThemeService
<button class="btn btn-outline-secondary rounded-pill d-flex align-items-center justify-content-center"
		@onclick="ToggleTheme"
		style="width: 40px; height: 40px; flex-shrink: 0; margin-right: 8px;">
	<i class="fas @(ThemeService.GetCurrentTheme() == "dark" ? "fa-sun" : "fa-moon")"></i>
</button>

@code {
	private async Task ToggleTheme()
	{
		await ThemeService.ToggleTheme();
	}
}